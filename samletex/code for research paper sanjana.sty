\subsection{Formal Execution-Loop Algorithms}
The complete operational lifecycle of the edge conversational agent is formalized in Algorithm~\ref{alg:main_loop}, and the MCP tool calling and visual dispatch mechanism is detailed in Algorithm~\ref{alg:mcp_tool}.

\begin{algorithm}[htbp]
\caption{Edge-to-Cloud Multimodal Multilingual Execution}
\label{alg:main_loop}
\begin{algorithmic}[1]
\REQUIRE Audio $A_{\text{in}}$, camera $C_{\text{in}}$, buttons $B_A, B_B$, Wi-Fi $W_{\text{stat}}$
\ENSURE Synthesized audio $A_{\text{out}}$, display $D_{\text{out}}$, LEDs $L_{\text{out}}$
\STATE Initialize I2S, ST7789 LCD, GC0308, RMT WS2812, NVS
\IF{$W_{\text{stat}} \neq \text{CONNECTED}$}
    \STATE Launch SoftAP captive portal and await Wi-Fi credentials
\ENDIF
\STATE Connect WebSocket client to Xiaozhi Gateway
\STATE Display dynamic 6-digit device code on LCD
\WHILE{System is active}
    \STATE Read buttons $B_A, B_B$; adjust volume or manual wake
    \STATE Monitor $A_{\text{in}}$ via VAD or wake word ``Jarvis''
    \IF{Wake event detected}
        \STATE Render ``Listening'' on LCD $D_{\text{out}}$
        \WHILE{VAD indicates speech activity}
            \STATE $p \leftarrow \text{Read\_I2S}()$; $o \leftarrow \text{Opus\_Encode}(p)$
            \STATE $\text{WS\_Send}(o)$ \COMMENT{Stream Opus chunks}
        \ENDWHILE
        \STATE $\text{WS\_Send}(\{\text{"type": "listen\_stop"}\})$
        \STATE Render ``Processing'' on LCD $D_{\text{out}}$
        \WHILE{Receiving downstream frames}
            \IF{Frame is binary audio}
                \STATE $d \leftarrow \text{Opus\_Decode}(\text{Frame})$
                \STATE $\text{Write\_I2S}(d)$ \COMMENT{Play to speaker}
            \ELSIF{Frame is JSON control}
                \STATE $\text{Execute\_Control\_Payload}(\text{Frame})$
            \ENDIF
        \ENDWHILE
        \STATE Render ``Idle'' expression on LCD $D_{\text{out}}$
    \ENDIF
\ENDWHILE
\end{algorithmic}
\end{algorithm}

\begin{algorithm}[htbp]
\caption{MCP Actuation and Visual Q\&A Dispatch}
\label{alg:mcp_tool}
\begin{algorithmic}[1]
\REQUIRE JSON control payload $J_{\text{ctrl}}$ from Cloud Gateway
\STATE $T_{\text{name}} \leftarrow J_{\text{ctrl}}[\text{"tool"}]$; $P \leftarrow J_{\text{ctrl}}[\text{"params"}]$
\IF{$T_{\text{name}} == \text{"set\_rgb\_color"}$}
    \STATE Extract $(R, G, B)$ and index $i$ from $P$
    \STATE \texttt{ws2812\_set\_pixel}(i, R, G, B); \texttt{ws2812\_show}()
    \STATE Return \texttt{\{"status": "success"\}} via WebSocket
\ELSIF{$T_{\text{name}} == \text{"capture\_visual\_frame"}$}
    \STATE $F_{\text{raw}} \leftarrow \text{camera\_fb\_get}()$
    \STATE Display snapshot $F_{\text{raw}}$ on 2.8-inch LCD $D_{\text{out}}$
    \STATE $F_{\text{b64}} \leftarrow \text{Base64}(F_{\text{raw}})$
    \STATE \texttt{camera\_fb\_return}($F_{\text{raw}}$)
    \STATE $\text{WS\_Send}(\{\text{"type": "image\_frame"}, \text{"data": } F_{\text{b64}}\})$
\ENDIF
\end{algorithmic}
\end{algorithm}

