\begin{tabular}{lcccccc}
\toprule
\textbf{Interaction Tier / Language} & \textbf{Edge VAD \& Buff.} & \textbf{Network Transport} & \textbf{Cloud STT} & \textbf{DeepSeek Reasoning} & \textbf{Cloud TTS} & \textbf{Total End-to-End Latency} \\
\midrule
Short Utterance (English) & 184 & 48 & 212 & 410 & 246 & \textbf{1100} $\pm$ 42 \\
Short Utterance (Hindi)   & 192 & 50 & 238 & 445 & 270 & \textbf{1195} $\pm$ 48 \\
Medium Utterance (English)& 210 & 58 & 315 & 580 & 322 & \textbf{1485} $\pm$ 56 \\
Medium Utterance (Hindi)  & 218 & 62 & 342 & 620 & 365 & \textbf{1607} $\pm$ 61 \\
Long Utterance (English)  & 235 & 72 & 420 & 790 & 345 & \textbf{1862} $\pm$ 74 \\
